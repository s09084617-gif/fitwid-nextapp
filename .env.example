# ── FitWid Environment Variables ─────────────────────────────
# Copy this file to .env.local for local dev, and add the same
# keys in Vercel → Project → Settings → Environment Variables.

# --- Phase 2: Supabase (database + auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 3: Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Phase 3: Cal.com (booking) ---
NEXT_PUBLIC_CAL_USERNAME=
CAL_API_KEY=

# --- Site config ---
NEXT_PUBLIC_SITE_URL=https://fitwid.fit
NEXT_PUBLIC_WHATSAPP_NUMBER=917015552731

# --- Admin Panel ---
# Comma-separated list of emails allowed into /dashboard/admin.
# Defaults to a hardcoded email in src/lib/admin.ts if unset.
NEXT_PUBLIC_ADMIN_EMAILS=

# --- AI Coach ---
# Required for the AI Coach chat (Workout/Nutrition Q&A, personalized
# motivation). Get a key at console.anthropic.com. Daily Tips work without
# this (they're a static rotating list), but the chat feature will show a
# "not configured" message until this is set.
ANTHROPIC_API_KEY=

# --- Email Automation (Task 31) ---
# Required for welcome emails, weekly reports, renewal reminders, and
# nutrition updates to actually send. Get a key at resend.com (free tier
# available). Without this, every send attempt returns a clear
# "not configured" message instead of failing silently.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Optional: protects /api/cron/weekly-emails from being called by anyone
# who finds the URL. Vercel Cron sends this automatically if set.
CRON_SECRET=
