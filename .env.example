# ── FitWid Environment Variables ─────────────────────────────
# Copy this file to .env.local for local dev, and add the same
# keys in Vercel → Project → Settings → Environment Variables.

# --- Phase 2: Supabase (database + auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site config ---
NEXT_PUBLIC_SITE_URL=https://fitwid.fit
NEXT_PUBLIC_WHATSAPP_NUMBER=917015552731

# --- Admin Panel ---
# Comma-separated list of emails allowed into /dashboard/admin.
# Defaults to a hardcoded email in src/lib/admin.ts if unset.
NEXT_PUBLIC_ADMIN_EMAILS=

# --- AI Coach ---
# Required for the AI Coach chat (Workout/Nutrition Q&A, personalized
# motivation). Get a key at console.anthropic.com. Daily Tips work without
# this (they're a static rotating list), but the chat feature will show a
# "not configured" message until this is set.
ANTHROPIC_API_KEY=

# Free-tier alternative to ANTHROPIC_API_KEY, used by AI Coach, the
# motivation feature, and the InBody Explainer if ANTHROPIC_API_KEY isn't
# set. Get a free key at openrouter.ai — uses the free Llama 3.3 70B model
# (meta-llama/llama-3.3-70b-instruct:free), no cost. Quality is a step
# below Claude but genuinely free. If both keys are set, Anthropic is used.
OPENROUTER_API_KEY=

# --- Email Automation (Task 31) ---
# Required for welcome emails, weekly reports, renewal reminders, and
# nutrition updates to actually send. Get a key at resend.com (free tier
# available). Without this, every send attempt returns a clear
# "not configured" message instead of failing silently.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Optional: protects /api/cron/weekly-emails from being called by anyone
# who finds the URL. Vercel Cron sends this automatically if set.
CRON_SECRET=

# --- Product Analytics (PostHog) ---
# Optional, but recommended for Phase 3/Phase 2 needs — funnels, session
# replay, "where users get confused". Sign up free at posthog.com, create
# a project, and paste its Project API Key here. Without this, the app
# works exactly the same; analytics events just silently no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Marketing Analytics (Task 8) ---
# Optional. Google Analytics 4 Measurement ID (starts with "G-"), from
# Google Analytics → Admin → Data Streams. Leave blank to skip GA4 entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Meta (Facebook/Instagram) Pixel ID, from Meta Events Manager.
# Only needed if you're running Facebook/Instagram ads. Leave blank to skip.
NEXT_PUBLIC_META_PIXEL_ID=

# Optional. Google Search Console verification code — after adding your
# property in Search Console, choose the "HTML tag" verification method
# and paste just the content value (not the whole <meta> tag) here.
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Payments (Task 9 — Razorpay) ---
# Required for real payment processing. Get keys from Razorpay Dashboard
# → Settings → API Keys. Without these, Billing falls back to the
# manual "Request This Plan" flow (WhatsApp follow-up), same as before.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional but recommended: set this to whatever secret you configure in
# Razorpay Dashboard → Settings → Webhooks (URL: https://fitwid.fit/api/webhooks/razorpay,
# event: payment.captured). This is a reliability backup — payments still
# get recorded via the checkout flow itself even without this, but the
# webhook catches the rare case where a browser closes right after paying.
RAZORPAY_WEBHOOK_SECRET=
